# Server
PORT=4000

# CORS - the origin your Vite frontend runs on
FRONTEND_ORIGIN=http://localhost:5173

# Playwright
# Set to "true" to run Chromium headless (no visible window).
# The brief asked for headful mode while testing, so this defaults to false.
PLAYWRIGHT_HEADLESS=false

# Viewport used for every scraper run
VIEWPORT_WIDTH=1920
VIEWPORT_HEIGHT=1080

# Milliseconds to wait for the page to be considered loaded
NAVIGATION_TIMEOUT_MS=60000

# Milliseconds to wait for the network to go fully idle before giving up
# and continuing anyway (some sites never go idle due to trackers/analytics)
NETWORK_IDLE_TIMEOUT_MS=15000
